# Copie para .env.production.local e preencha com os valores da branch
# production. Este arquivo NUNCA sai daqui com valor real — é só placeholder.
#
# O .env.production.local não é commitado e NÃO é lido pelo `next dev`: só os
# quatro comandos de produção o carregam, por --env-file explícito.
#
#   pnpm db:migrate:prod        --eu-confirmo
#   pnpm auth:probe-prod        --eu-confirmo
#   pnpm auth:create-prod-users --eu-confirmo
#   pnpm db:bootstrap:prod      --eu-confirmo
#
# A ordem está em docs/PRODUCTION.md e importa.

# Trava: sem isto em "production", os quatro comandos abortam.
NEON_BRANCH=production

# Connection string DIRETA da branch production — host SEM "-pooler".
# Só existe nesta máquina. A pooled vai para a Vercel, nunca para cá.
DATABASE_URL_UNPOOLED=replace-me

# Auth da branch production. Tratada como dado sensível (D-043).
NEON_AUTH_BASE_URL=replace-me
# Valor NOVO, exclusivo de produção, com no mínimo 32 caracteres.
# Nunca reaproveitar o de development.
NEON_AUTH_COOKIE_SECRET=replace-me

# Exatamente os mesmos dois e-mails configurados na Vercel. Se divergirem, o
# webhook recusa a conta real e o auth:create-prod-users reporta BLOQUEADA.
ALLOWED_EMAILS=replace-me,replace-me
DATE_OWNER_EMAIL=replace-me

# URL final do app. Vai no header Origin do cadastro; o provedor recusa sem ela.
DATE_PROD_ORIGIN=https://replace-me

# Senhas das duas contas reais, usadas uma vez pelo auth:create-prod-users.
# Formato: email:senha,email:senha — a senha não pode conter vírgula.
DATE_PROD_USER_CREDENTIALS=replace-me:replace-me,replace-me:replace-me

# Ids devolvidos pelo comando acima, usados pelo db:bootstrap:prod.
# Formato: id:email,id:email
DATE_PROD_AUTH_USERS=replace-me

# Nome do workspace criado na primeira execução do bootstrap. Opcional.
# DATE_WORKSPACE_NAME=DATE
