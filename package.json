{
  "name": "date",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "test:media": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.r2.config.mts",
    "test:tz": "node tests/run-in-timezones.mjs",
    "shots": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/kitchen-sink.spec.ts tests/e2e/login.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types db/migrate.ts",
    "db:seed": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types db/seed.ts",
    "r2:check": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types db/r2-check.ts",
    "format": "prettier --write .",
    "shots:auth": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/login.spec.ts",
    "test:http": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/auth-boundary.spec.ts tests/e2e/login-errors.spec.ts",
    "auth:bootstrap-dev": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types db/auth-bootstrap.ts",
    "auth:create-dev-users": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types db/auth-create-dev-users.ts",
    "test:auth": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/auth-live.spec.ts",
    "test:crud": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/plans-crud.spec.ts",
    "shots:plans": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/plans-shots.spec.ts",
    "test:media-e2e": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/media.spec.ts",
    "shots:media": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/media-shots.spec.ts",
    "test:dates": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/dates.spec.ts",
    "shots:dates": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/dates-shots.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
