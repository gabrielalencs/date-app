# Copie para .env.local e preencha com os valores do ambiente de desenvolvimento.
# .env.local nunca é commitado. Nenhuma variável daqui usa prefixo NEXT_PUBLIC_.

# Neon — branch development (B2)
# Trava de segurança: migration e seed abortam se não for exatamente "development".
NEON_BRANCH=development
# Usada pelo runtime da aplicação (pooled).
DATABASE_URL=replace-me
# Usada por migration e seed (conexão direta, sem pooler).
DATABASE_URL_UNPOOLED=replace-me

# Auth — Managed Better Auth / Neon Auth (B3)
# Nomes confirmados no SDK @neondatabase/auth 0.5.0-beta.
NEON_AUTH_BASE_URL=replace-me
# Assinatura do cookie de sessão. Mínimo de 32 caracteres, exigido pelo SDK.
NEON_AUTH_COOKIE_SECRET=replace-me
# Exatamente dois e-mails, separados por vírgula. Nada além disso entra no DATE.
ALLOWED_EMAILS=replace-me,replace-me
# Precisa ser um dos dois acima. Recebe role owner no bootstrap.
DATE_OWNER_EMAIL=replace-me

# Provisionamento das contas de development (pnpm auth:create-dev-users).
# Formato: email:senha,email:senha — os e-mails precisam ser os de ALLOWED_EMAILS.
# A senha não pode conter vírgula. Só local, nunca commitado.
DATE_DEV_USER_CREDENTIALS=replace-me:replace-me,replace-me:replace-me

# Ids devolvidos pelo script acima, usados por pnpm auth:bootstrap-dev.
# Formato: id:email,id:email
DATE_DEV_AUTH_USERS=replace-me

# Vitrine do design system. Sem isto a rota /kitchen-sink não existe (D-034).
# Nunca definir na Vercel.
DATE_ENABLE_KITCHEN_SINK=true

# Teste live de auth (pnpm test:auth). Só local, nunca commitado.
DATE_TEST_EMAIL=replace-me
DATE_TEST_PASSWORD=replace-me

# Cloudflare R2 — bucket privado de desenvolvimento (B5)
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=date-media-dev
